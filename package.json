{
  "name": "kodhanem-stok",
  "version": "1.0.2",
  "description": "Kodhanem Stok Takip Programı — Cross-Platform Inventory, Sales & POS Management",
  "main": "dist/main/index.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev": "tsc -p tsconfig.main.json && vite build --emptyOutDir && electron .",
    "build": "tsc -p tsconfig.main.json && vite build && electron-builder",
    "build:mac": "tsc -p tsconfig.main.json && vite build && electron-builder --mac",
    "build:win": "tsc -p tsconfig.main.json && vite build && electron-builder --win",
    "compile": "tsc -p tsconfig.main.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps",
    "key-gen": "node scripts/generate-key.js"
  },
  "keywords": [
    "electron",
    "react",
    "sqlite",
    "inventory",
    "pos",
    "stok-takip"
  ],
  "author": "Antigravity Architect",
  "license": "MIT",
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-tabs": "^1.1.3",
    "@tanstack/react-table": "^8.20.6",
    "better-sqlite3": "^11.8.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.38.4",
    "electron-updater": "^6.8.9",
    "jsbarcode": "^3.11.6",
    "lucide-react": "^0.474.0",
    "papaparse": "^5.5.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^22.13.1",
    "@types/papaparse": "^5.3.15",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.4",
    "electron": "^34.1.0",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
